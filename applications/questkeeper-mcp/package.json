{
  "name": "questkeeper-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server for Marie's Questkeeper notes, groups and images (Claude custom connector).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=mcp.local.env src/index.ts",
    "dev:fake": "tsx scripts/dev-with-fake-api.ts",
    "dev:token": "tsx scripts/dev-token.ts",
    "cli": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
