# Kopieren nach mcp.env und ausfüllen. mcp.env nie einchecken.

# Öffentliche Adresse (Cloudflare-Hostname), ohne / am Ende. Der Konnektor in Claude ist <PUBLIC_BASE_URL>/mcp.
PUBLIC_BASE_URL=https://notizen.example.de

# Login für Marie: Hash erzeugen mit
#   docker compose run --rm questkeeper_mcp node dist/cli.js passwort-hash
LOGIN_PASSWORD_HASH=
# Optional zweiter Faktor (Authenticator-App): docker compose run --rm questkeeper_mcp node dist/cli.js totp-geheimnis
#LOGIN_TOTP_SECRET=

# Maries API-Schlüssel aus der Questkeeper-App (Rechte: notes:read, notes:write, campaigns:read).
QK_API_KEY=
#QK_API_BASE_URL=https://questkeeper-prod.peter-esser.de/api/external/v1
# Optional: nur diese Kampagnen (IDs, kommagetrennt). Leer = alle von Marie.
#QK_CAMPAIGN_IDS=

# Optional: Bildgenerierung mit OpenAI. Eigenes Projekt mit Ausgabelimit anlegen.
#OPENAI_API_KEY=
#OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
#OPENAI_IMAGE_QUALITY=medium
#OPENAI_MAX_IMAGES_PER_DAY=20

# Nur falls die automatische Anmeldung von Claude scheitert: fester Client für
# "Eigenen OAuth-Client verwenden" in Claude (beliebige lange Zufallszeichenkette).
#STATIC_CLIENT_ID=

#LOG_LEVEL=info
